#!/usr/bin/env bash
# EXAMPLE forced-command wrapper for the dedicated CI deploy SSH key.
# Install this as a root-owned 0755 script OUTSIDE the repository on the VPS and
# pin its absolute path in the deploy account's authorized_keys entry with
# restrict,command="/usr/local/sbin/pitpulse-deploy". Review and adapt the
# sudoers/account policy for the real host before use; nothing here installs it.
#
# The key's forced command is invoked with the exact SSH_ORIGINAL_COMMAND sent by
# deploy.yml:
#   ssh pitpulse-deploy "put <full-commit-sha>"       with one base64 line
#                                                      containing the SHA and
#                                                      the raw artifact ZIP
#                                                      SHA-256, then ZIP bytes
#   ssh pitpulse-deploy "deploy <full-commit-sha>"    with the base64-encoded
#                                                      trusted deploy scripts on
#                                                      stdin
#   ssh pitpulse-deploy "cleanup <full-commit-sha>"  remove only that SHA's
#                                                      staging files
#
# No arbitrary shell, path, user, or command from CI is accepted. The raw
# GitHub Actions artifact ZIP is checked against the immutable ZIP digest
# published for this exact commit and a successful main-branch CI run. Its own
# VERSION, SHA256SUMS and ELF/ABI are checked again by deploy-release.sh. The
# runner invokes only a root-owned launcher through a fixed sudoers rule; it
# never reads the token, supplies root environment variables, or writes /etc
# directly.

set -Eeuo pipefail
umask 077

INCOMING=/opt/pitpulse/releases.incoming
STAGING=/var/tmp/pitpulse-deploy
HELPERS=/usr/local/lib/pitpulse
ARCHIVE_MAX_BYTES=$((128 * 1024 * 1024))
SCRIPT_MAX_BYTES=$((1024 * 1024))
DEPLOY_LAUNCHER=/usr/local/sbin/pitpulse-deploy-release

fail() {
    printf '[pitpulse-deploy] denied: %s\n' "$1" >&2
    exit 1
}

require_commands() {
    local name
    for name in "$@"; do
        command -v "$name" >/dev/null 2>&1 || fail "missing $name"
    done
}

require_commands install rm mkdir head tail grep base64 tar sudo mktemp cmp wc \
    sha256sum cut curl jq unzip sort
[[ -n "${SSH_ORIGINAL_COMMAND:-}" ]] || fail "missing original command"
if [[ "$SSH_ORIGINAL_COMMAND" =~ ^(put|deploy|cleanup)[[:space:]]([0-9a-f]{40})$ ]]; then
    action="${BASH_REMATCH[1]}"
    sha="${BASH_REMATCH[2]}"
else
    fail "unsupported command"
fi
[[ ${#sha} -eq 40 ]] || fail "invalid commit SHA"

case "$action" in
    put)
        install -d -m 0755 "$INCOMING"
        temp="$(mktemp "$INCOMING/.upload.XXXXXX")"
        trap 'rm -rf "$temp" "$temp.payload" "$temp.zipdir"' EXIT
        head -c "$((ARCHIVE_MAX_BYTES + 1))" > "$temp"
        size="$(wc -c < "$temp")"
        (( size > 0 && size <= ARCHIVE_MAX_BYTES )) || fail "artifact size out of range"
        IFS= read -r request_line < "$temp" || fail "missing artifact request"
        request="$(printf '%s' "$request_line" | base64 -d)" || fail "artifact request is not base64"
        read -r request_sha request_digest extra <<<"$request"
        [[ -z "$extra" && "$request_sha" == "$sha" && "$request_digest" =~ ^[0-9a-f]{64}$ ]] ||
            fail "artifact request does not match the forced-command SHA"
        tail -n +2 "$temp" > "$temp.payload"

        # GitHub's artifact digest covers the ZIP bytes, not the .tar.gz member.
        # Hash the bytes exactly as received; never rebuild the ZIP locally.
        actual_digest="$(sha256sum "$temp.payload" | cut -d' ' -f1)"
        [[ "$actual_digest" == "$request_digest" ]] ||
            fail "raw artifact ZIP digest does not match its request"

        expected_archive="pitpulse-server-linux-x86_64-${sha}.tar.gz"
        expected_checksum="${expected_archive}.sha256"
        expected_members="$(printf '%s\n%s\n' "$expected_archive" "$expected_checksum" | LC_ALL=C sort)"
        actual_members="$(unzip -Z1 "$temp.payload" | LC_ALL=C sort)" ||
            fail "artifact payload is not a ZIP"
        [[ "$actual_members" == "$expected_members" ]] ||
            fail "artifact ZIP has unexpected members"
        mkdir -p "$temp.zipdir"
        unzip -q "$temp.payload" "$expected_archive" "$expected_checksum" \
            -d "$temp.zipdir" || fail "cannot extract approved artifact ZIP members"
        archive_member="$temp.zipdir/$expected_archive"
        checksum_member="$temp.zipdir/$expected_checksum"
        [[ -f "$archive_member" && ! -L "$archive_member" &&
           -f "$checksum_member" && ! -L "$checksum_member" ]] ||
            fail "artifact ZIP members are missing or linked"
        checksum_digest="$(cut -d' ' -f1 "$checksum_member")"
        [[ "$checksum_digest" =~ ^[0-9a-f]{64}$ ]] || fail "artifact checksum is malformed"
        grep -Fqx "$checksum_digest  $expected_archive" "$checksum_member" ||
            fail "artifact checksum does not reference the approved archive"
        [[ "$(sha256sum "$archive_member" | cut -d' ' -f1)" == "$checksum_digest" ]] ||
            fail "artifact archive checksum failed"
        (
            cd "$temp.zipdir"
            sha256sum -c "$(basename "$checksum_member")"
        ) >/dev/null || fail "artifact archive checksum file failed"

        # Independently find a fully successful main CI run for this commit
        # whose published raw ZIP digest is exactly the uploaded digest. The
        # forced command does not trust a run ID or digest from the CI runner,
        # uses only the public GitHub API, and needs no token.
        repo="aczeccssa/PitPulse"
        endpoint="https://api.github.com/repos/$repo"
        header=(-H 'Accept: application/vnd.github+json' -H 'User-Agent: pitpulse-vps-verify')
        runs_url="$endpoint/actions/workflows/ci.yml/runs?head_sha=$sha&event=push&branch=main&status=completed&per_page=100"
        runs="$(curl -fsSL "${header[@]}" "$runs_url")" ||
            fail "cannot query GitHub Actions runs for this commit"
        run_ids="$(jq -r --arg sha "$sha" '
            [.workflow_runs[] | select(
                .name == "CI" and .event == "push" and .head_branch == "main"
                and .head_sha == $sha and .status == "completed"
                and .conclusion == "success"
            )] | sort_by(.created_at) | .[].id // empty
        ' <<<"$runs")"
        [[ -n "$run_ids" ]] || fail "no successful main CI run for this commit"
        published_match=0
        while IFS= read -r run_id; do
            [[ "$run_id" =~ ^[0-9]+$ ]] || fail "invalid CI run ID"
            artifacts="$(curl -fsSL "${header[@]}" \
                "$endpoint/actions/runs/$run_id/artifacts?per_page=100")" ||
                fail "cannot query CI artifacts"
            count="$(jq -r --arg sha "$sha" --arg digest "sha256:$actual_digest" '
                [.artifacts[] | select(
                    .name == ("pitpulse-server-linux-x86_64-" + $sha)
                    and .expired == false and .digest == $digest
                    and .workflow_run.head_branch == "main"
                    and .workflow_run.head_sha == $sha
                )] | length
            ' <<<"$artifacts")"
            [[ "$count" =~ ^[0-9]+$ ]] || fail "invalid CI artifact response"
            (( count <= 1 )) || fail "duplicate published artifacts for this CI run"
            if (( count == 1 )); then
                server_jobs="$(curl -fsSL "${header[@]}" \
                    "$endpoint/actions/runs/$run_id/jobs?per_page=100")" ||
                    fail "cannot query the CI server job"
                jq -e '[.jobs[] | select(.name == "Server fmt / clippy / test / build")] |
                    length == 1 and .[0].status == "completed" and .[0].conclusion == "success"
                ' <<<"$server_jobs" >/dev/null || fail "the CI server job did not pass"
                published_match=1
                break
            fi
        done <<<"$run_ids"
        (( published_match == 1 )) ||
            fail "artifact ZIP digest does not match a published successful CI artifact"
        unexpected="$(tar -tzf "$archive_member" | grep -Ev '^(pitpulse-server|VERSION|SHA256SUMS|ldd\.txt|config\.production\.toml|pitpulse-server\.service|pitpulse\.caddyfile)$' || true)"
        [[ -z "$unexpected" ]] || fail "artifact contains unexpected paths"
        install -m 0644 "$archive_member" "$INCOMING/${sha}.tar.gz"
        ;;
    deploy)
        install -d -m 0700 "$STAGING"
        scripts="$(mktemp "$STAGING/scripts.XXXXXX")"
        trap 'rm -rf "$scripts" "$STAGING/unpacked" "$STAGING/bundle.tar.gz"' EXIT
        head -c "$((SCRIPT_MAX_BYTES + 1))" > "$scripts"
        size="$(wc -c < "$scripts")"
        (( size > 0 && size <= SCRIPT_MAX_BYTES )) || fail "script bundle size out of range"
        base64 -d < "$scripts" > "$STAGING/bundle.tar.gz"
        rm -rf "$STAGING/unpacked"
        mkdir -p "$STAGING/unpacked"
        unexpected="$(tar -tzf "$STAGING/bundle.tar.gz" | grep -Ev '^(lib\.sh|deploy-release\.sh|rollback-release\.sh)$' || true)"
        [[ -z "$unexpected" ]] || fail "script bundle contains unexpected paths"
        tar -xzf "$STAGING/bundle.tar.gz" -C "$STAGING/unpacked" --no-same-owner --no-same-permissions
        for name in lib.sh deploy-release.sh rollback-release.sh; do
            [[ -f "$STAGING/unpacked/$name" && ! -L "$STAGING/unpacked/$name" ]] || fail "missing $name"
            cmp -s "$STAGING/unpacked/$name" "$HELPERS/$name" || fail "$name differs from the installed helper"
        done
        rm -f "$STAGING/bundle.tar.gz"
        sudo -n "$DEPLOY_LAUNCHER" "$sha"
        ;;
    cleanup)
        rm -f "$INCOMING/${sha}.tar.gz"
        rm -rf "$STAGING"
        ;;
    *)
        fail "unsupported action"
        ;;
esac
