[Unit]
Description=PitPulse F1 Companion API
Documentation=https://github.com/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=f1-companion
Group=f1-companion
EnvironmentFile=/etc/f1-companion/environment
ExecStart=/opt/f1-companion/pitpulse-server
WorkingDirectory=/var/lib/f1-companion
StateDirectory=f1-companion
ConfigurationDirectory=f1-companion
RuntimeDirectory=f1-companion
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/f1-companion

[Install]
WantedBy=multi-user.target
